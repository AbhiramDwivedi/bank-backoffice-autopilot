# Required only by `cu discover`; replay and validate never call the LLM.
ANTHROPIC_API_KEY=
# Optional workspace to scope and bill discovery requests to.
ANTHROPIC_WORKSPACE_ID=
# Optional model override for the discovery agent.
ANTHROPIC_MODEL=claude-opus-5
# Optional model override for the Claude-backed risk judge (default: a small, fast model).
# ANTHROPIC_JUDGE_MODEL=
# Optional. The key for the Jev risk judge: `--risk-judge jev` on `cu discover` and `cu audit`.
# The default (`auto`) uses the Claude judge on ANTHROPIC_API_KEY, and Jev only when that is unset.
# TYPESAFE_API_KEY=
# Optional. Where secret bindings resolve: env (default) | file:<path> | exec:<command>.
# CU_CREDENTIALS=env
# Mock app sign-on user (defaults to this value if unset).
MOCK_USER=operator1
# Mock app sign-on password, a demo value for the local mock app only.
MOCK_PASSWORD=demo-pass-123
