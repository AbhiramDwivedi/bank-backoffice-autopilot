<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<%- include('partials/cu-agent') %>
<title><%= tenant.institution %> - CU Core Workstation - Login</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
</head>
<body bgcolor="#C0C0C0" text="#000000" link="#0000CC" vlink="#551A8B">
<table width="100%" cellpadding="0" cellspacing="0" border="0">
<tr>
<td bgcolor="<%= tenant.bannerBg %>" align="center">
<img src="/static/img/spacer.gif" width="1" height="6"><br>
<font face="Verdana,Arial" color="<%= tenant.bannerFg %>" size="4"><b><%= tenant.institution %></b></font><br>
<font face="Verdana,Arial" color="<%= tenant.bannerFg %>" size="2">CU Core Workstation</font><br>
<img src="/static/img/spacer.gif" width="1" height="6">
</td>
</tr>
</table>
<img src="/static/img/spacer.gif" width="1" height="20"><br>
<center>
<form method="post" action="/login">
<table width="380" cellpadding="4" cellspacing="0" border="1" bgcolor="#FFFFFF">
<tr>
<td align="center" colspan="2" bgcolor="#DDDDDD">
<font face="Verdana,Arial" size="3"><b>Operator Sign-On</b></font>
</td>
</tr>
<tr><td colspan="2" align="center"><img src="/static/img/spacer.gif" width="1" height="6"></td></tr>
<% if (typeof error !== 'undefined' && error) { %>
<tr>
<td align="center" colspan="2">
<font color="red" face="Verdana" size="2"><%= error %></font>
</td>
</tr>
<tr><td colspan="2" align="center"><img src="/static/img/spacer.gif" width="1" height="6"></td></tr>
<% } %>
<tr>
<td align="right"><font face="Verdana,Arial" size="2">User ID:</font></td>
<td><input type="text" name="userId" size="20"></td>
</tr>
<tr><td colspan="2"><img src="/static/img/spacer.gif" width="1" height="4"></td></tr>
<tr>
<td align="right"><font face="Verdana,Arial" size="2">Password:</font></td>
<td><input type="password" name="password" size="20"></td>
</tr>
<tr>
<td colspan="2" align="center">
<img src="/static/img/spacer.gif" width="1" height="10"><br>
<input type="image" src="/static/img/btn_login.png" name="login">
</td>
</tr>
</table>
</form>
</center>
<img src="/static/img/spacer.gif" width="1" height="20"><br>
<center>
<font face="Verdana,Arial" size="1">(c) 1998-2012 Acme Core Systems. All rights reserved.<br>
CU Core Workstation and the CU Core Workstation logo are trademarks of Acme Core Systems.<br>
Best viewed at 800x600 with Netscape Navigator 4.0 or Microsoft Internet Explorer 4.0 or higher.</font>
</center>
</body>
</html>
