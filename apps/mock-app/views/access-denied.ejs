<html>
<head>
<%- include('partials/cu-agent') %>
<title>Access Denied</title>
<style type="text/css">
body { font-family: Verdana, Arial, sans-serif; font-size: 12px; color: #000000; background-color: #FFFFFF; margin: 20px; }
h1 { color: #CC0000; font-size: 20px; }
.denied { color: #CC0000; font-weight: bold; font-size: 13px; }
</style>
</head>
<body>
<table border="0" width="100%" cellpadding="0" cellspacing="0">
<tr><td bgcolor="<%= tenant.bannerBg %>"><font color="<%= tenant.bannerFg %>" face="Verdana, Arial, sans-serif"><b>&nbsp;<%= tenant.institution %> - <%= PRODUCT %></b></font></td></tr>
</table>
<h1>Access Denied</h1>
<p class="denied">Access Denied: your role does not permit viewing this member.</p>
<p>Member ID: <%= memberId %></p>
<p><a href="/members/search">Back to Search</a></p>
</body>
</html>
