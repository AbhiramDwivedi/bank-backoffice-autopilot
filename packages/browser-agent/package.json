{
  "name": "@cu/browser-agent",
  "version": "1.4.0",
  "description": "Dependency-free in-page agent: accessible naming, element enumeration and value-free human-action capture, injected by a driver or included by the app as a script tag.",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./dist/cu-agent.js": "./dist/cu-agent.js",
    "./dist/cu-agent.d.ts": "./dist/cu-agent.d.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "build.mjs"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "esbuild": "^0.28.2"
  }
