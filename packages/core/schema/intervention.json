{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Intervention",
  "$defs": {
    "Intervention": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "runKind": {
          "type": "string",
          "enum": [
            "discovery",
            "replay"
          ]
        },
        "capabilityId": {
          "type": "string"
        },
        "goal": {
          "type": "string"
        },
        "stepId": {
          "type": "string"
        },
        "reason": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "stuck",
                "risky_action_confirmation",
                "unrecoverable_condition",
                "policy_block",
                "max_steps",
                "unexpected_dialog"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false
        },
        "screenshotPath": {
          "type": "string"
        },
        "currentUrl": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "human_active",
            "resolved",
            "abandoned"
          ]
        },
        "resolution": {
          "type": "object",
          "properties": {
            "by": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
            },
            "notes": {
              "type": "string"
            },
            "humanActions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ts": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "click",
                      "input",
                      "keypress",
                      "navigate",
                      "submit"
                    ]
                  },
                  "frame": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "urlPattern": {
                          "type": "string"
                        },
                        "index": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "target": {
                    "type": "object",
                    "properties": {
                      "tag": {
                        "type": "string"
                      },
                      "role": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "selector": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  },
                  "valueRedacted": {
                    "type": "boolean"
                  },
                  "key": {
                    "type": "string"
                  },
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "ts",
                  "type",
                  "frame",
                  "target"
                ],
                "additionalProperties": false
              }
            },
            "resumeFrom": {
              "type": "string",
              "enum": [
                "current_step",
                "next_step",
                "abort"
              ]
            },
            "resumeAtStepId": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "by",
            "at",
            "humanActions",
            "resumeFrom"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "runId",
        "runKind",
        "reason",
        "createdAt",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/AbhiramDwivedi/bank-backoffice-autopilot/schema/intervention.json",
  "title": "Intervention"
}
