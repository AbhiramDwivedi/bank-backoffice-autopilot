{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RunEvent",
  "$defs": {
    "RunEvent": {
      "type": "object",
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "run_started",
            "run_finished",
            "observation",
            "decision",
            "action",
            "action_result",
            "locator_resolved",
            "checkpoint",
            "recovery",
            "outcome",
            "policy",
            "escalation",
            "control_transfer",
            "human_action",
            "error"
          ]
        },
        "stepId": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "evidence": {
          "type": "object",
          "properties": {
            "screenshot": {
              "type": "string"
            },
            "dom": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "runId",
        "seq",
        "ts",
        "kind",
        "data"
      ],
      "additionalProperties": false
    }
  },
  "$id": "https://github.com/AbhiramDwivedi/bank-backoffice-autopilot/schema/run-event.json",
  "title": "Run Event"
}
